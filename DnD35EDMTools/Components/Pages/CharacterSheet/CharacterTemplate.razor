@page "/CharacterTemplate"

@using DnD35EDMTools.Data
@using DnD35EDMTools.Data.Classes
@using DnD35EDMTools.Data.Enums
@using DnD35EDMTools.Helpers
@using Microsoft.EntityFrameworkCore
@inherits DnD35EDMTools.Components.Pages.Common.BaseComponent

<PageTitle>Character Template</PageTitle>

<div class="dnd-container">
<div class="dnd-main-content">
<div>
    <select class="cc-select" id="character-id" name="character" @bind="SelectedCharacterId">
        @foreach (var id in _characters)
        {
            <option value="@id.Id" title="@id.Name">@id.Name</option>
        }
    </select>
    <button
        @onclick="() => LoadCharacterAsync(SelectedCharacterId)">
        Load
    </button>
</div>

<div class="dnd-character-sheet-header">@(_characterName)</div>
<div class="dnd-character-sheet">
<div class="dnd-cs-top-section">
<div class="dnd-cs-top__left">
<div class="attributes-row">
    <div class="attributes-row-header">Attributes</div>
    <div class="attributes-row-content">
        <div class="dnd-cs-image-container">
            <img src="images/Portrait_Blank.jpg" alt="Character Portrait">
        </div>
        <div class="attributes-content">
            <div class="attribute-list">
                <div class="attribute-list-row-header">Class</div>
                <div class="attribute-list__content"> @_characterClass</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Race</div>
                <div class="attribute-list__content"> @_characterRace</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Experience</div>
                <div class="attribute-list__content"> @_characterExperience</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Hit Points</div>
                <div class="attribute-list__content"> @_characterHitPoints</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Alignment</div>
                <div class="attribute-list__content"> @_characterAlignment</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Deity</div>
                <div class="attribute-list__content"> @_characterDeity</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Age</div>
                <div class="attribute-list__content"> @_characterAge</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Gender</div>
                <div class="attribute-list__content"> @_characterGender</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Eyes</div>
                <div class="attribute-list__content"> @_characterEyes</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Hair</div>
                <div class="attribute-list__content"> @_characterHair</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Skin</div>
                <div class="attribute-list__content"> @_characterSkin</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Weight</div>
                <div class="attribute-list__content"> @_characterWeight</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Height</div>
                <div class="attribute-list__content"> @_characterHeight</div>
            </div>
            <div class="attribute-list">
                <div class="attribute-list-row-header">Player</div>
                <div class="attribute-list__content"> @_characterPlayerName</div>
            </div>
        </div>
    </div>
</div>
<div class="languages-row">
    <div class="languages-row-header">Languages</div>
    @for (int row = 0; row < 7; row++)
    {
        <div class="languages-list">
            @for (int col = 0; col < 3; col++)
            {
                int index = row * 3 + col;
                <div class="languages-list-row-content">@_characterLanguages[index]</div>
            }
        </div>
    }
</div>
<div class="wealth-row">
    <div class="wealth-row-header">Wealth</div>
    <div class="wealth-list">
        <div class="wealth-list-row-header">PP</div>
        <div class="wealth-list-row-header">GP</div>
        <div class="wealth-list-row-header">SP</div>
        <div class="wealth-list-row-header">CP</div>
        <div class="wealth-list-row-header">Bank</div>
        <div class="wealth-list-row-header">Interest</div>
    </div>
    <div class="wealth-list">
        <div class="wealth-list-row-content">@_characterPlatinum</div>
        <div class="wealth-list-row-content">@_characterGold</div>
        <div class="wealth-list-row-content">@_characterSilver</div>
        <div class="wealth-list-row-content">@_characterCopper</div>
        <div class="wealth-list-row-content"></div>
        <div class="wealth-list-row-content"></div>
    </div>
    <div class="load-speed-list">
        <div class="load-speed-list-row-header">Weight Carried</div>
        <div class="load-speed-list-row-header">Speed (Run)</div>
        <div class="load-speed-list-row-header">Initiative</div>
    </div>
    <div class="load-speed-list">
        <div class="load-speed-list-row-content">@_characterWeightCarried</div>
        <div class="load-speed-list-row-content">@_characterSpeed</div>
        <div class="load-speed-list-row-content"></div>
    </div>
    <div class="load-speed-list">
        <div class="load-speed-list-row-header">Light Load</div>
        <div class="load-speed-list-row-header">Lift Over Head</div>
        <div class="load-speed-list-row-header">Arcane Spell Failure</div>
    </div>
    <div class="load-speed-list">
        <div class="load-speed-list-row-content">@_characterLightLoad</div>
        <div class="load-speed-list-row-content">@_characterLiftOverHead</div>
        <div class="load-speed-list-row-content">@_characterArcaneSpellFailure</div>
    </div>
    <div class="load-speed-list">
        <div class="load-speed-list-row-header">Medium Load</div>
        <div class="load-speed-list-row-header">Lift off Ground</div>
        <div class="load-speed-list-row-header">Base Attack Bonus</div>
    </div>
    <div class="load-speed-list">
        <div class="load-speed-list-row-content">@_characterMediumLoad</div>
        <div class="load-speed-list-row-content">@_characterLiftOffGround</div>
        <div class="load-speed-list-row-content">@_characterBaseAttackBonus</div>
    </div>
    <div class="load-speed-list">
        <div class="load-speed-list-row-header">Heavy Load</div>
        <div class="load-speed-list-row-header">Push or Drag</div>
        <div class="load-speed-list-row-header">Spell Resistance</div>
    </div>
    <div class="load-speed-list">
        <div class="load-speed-list-row-content">@_characterHeavyLoad</div>
        <div class="load-speed-list-row-content">@_characterPushOrDrag</div>
        <div class="load-speed-list-row-content"></div>
    </div>
</div>
<div class="abilities-row">
    <div class="abilities-list">
        <div class="abilities-row-header">Abilities</div>
        <div class="abilities-row-header">Score</div>
        <div class="abilities-row-header">Modifier</div>
        <div class="abilities-row-header">Saves</div>
        <div class="abilities-row-header">Total</div>
    </div>
    <div class="abilities-list">
        <div class="abilities-list-row-header">STR</div>
        <div class="abilities-list-row-content">@_characterStrength</div>
        <div class="abilities-list-row-content">@_characterStrengthMod</div>
        <div class="abilities-list-row-header">Fortitude</div>
        <div class="abilities-list-row-content">@_characterFortSave</div>
    </div>
    <div class="abilities-list">
        <div class="abilities-list-row-header">DEX</div>
        <div class="abilities-list-row-content">@_characterDexterity</div>
        <div class="abilities-list-row-content">@_characterDexterityMod</div>
        <div class="abilities-list-row-header">Reflex</div>
        <div class="abilities-list-row-content">@_characterRefSave</div>
    </div>
    <div class="abilities-list">
        <div class="abilities-list-row-header">CON</div>
        <div class="abilities-list-row-content">@_characterConstitution</div>
        <div class="abilities-list-row-content">@_characterConstitutionMod</div>
        <div class="abilities-list-row-header">Will</div>
        <div class="abilities-list-row-content">@_characterWillSave</div>
    </div>
    <div class="abilities-list">
        <div class="abilities-list-row-header">INT</div>
        <div class="abilities-list-row-content">@_characterIntelligence</div>
        <div class="abilities-list-row-content">@_characterIntelligenceMod</div>
        <div class="abilities-list-row-header">Other Stats</div>
        <div class="abilities-list-row-header">Total</div>
    </div>
    <div class="abilities-list">
        <div class="abilities-list-row-header">WIS</div>
        <div class="abilities-list-row-content">@_characterWisdom</div>
        <div class="abilities-list-row-content">@_characterWisdomMod</div>
        <div class="abilities-list-row-header">Avatar Points</div>
        <div class="abilities-list-row-content"></div>
    </div>
    <div class="abilities-list">
        <div class="abilities-list-row-header">CHA</div>
        <div class="abilities-list-row-content">@_characterCharisma</div>
        <div class="abilities-list-row-content">@_characterCharismaMod</div>
        <div class="abilities-list-row-header">Essentia Points</div>
        <div class="abilities-list-row-content"></div>
    </div>
    <div class="abilities-list">
        <div class="abilities-list-row-header">LCK</div>
        <div class="abilities-list-row-content">@_characterLuck</div>
        <div class="abilities-list-row-content">@_characterLuckMod</div>
        <div class="abilities-list-row-header">Reputation</div>
        <div class="abilities-list-row-content"></div>
    </div>
</div>
<div class="dr-immunities-row">
    <div class="dr-immunities-list-row-header">Damage Reduction</div>
    <div class="dr-immunities-list-row-content"></div>
    <div class="dr-immunities-list-row-header">Immunities</div>
    <div class="dr-immunities-list-row-content"></div>
</div>
<div class="worn-armour-row">
    <div class="worn-armour-list">
        <div class="worn-armour-row-header">Worn Armour</div>
        <div class="worn-armour-row-header">AC</div>
        <div class="worn-armour-row-header">Check</div>
        <div class="worn-armour-row-header">Type</div>
        <div class="worn-armour-row-header">Max Dex</div>
    </div>
    <div class="worn-armour-list">
        <div class="worn-armour-list-row-content">@_wornArmour</div>
        <div class="worn-armour-list-row-content">@_bodyArmourClass</div>
        <div class="worn-armour-list-row-content">@_bodyCheckPenalty</div>
        <div class="worn-armour-list-row-content">@_bodyArmourType</div>
        <div class="worn-armour-list-row-content">@_bodyMaxDexBonus</div>
    </div>
    <div class="worn-armour-list">
        <div class="worn-armour-list-row-content">@_wornShield</div>
        <div class="worn-armour-list-row-content">@_shieldArmourClass</div>
        <div class="worn-armour-list-row-content">@_shieldCheckPenalty</div>
        <div class="worn-armour-list-row-content">@_shieldArmourType</div>
        <div class="worn-armour-list-row-content">@_shieldMaxDexBonus</div>
    </div>
</div>
<div class="armour-row">
    <div class="armour-list">
        <div class="armour-row-header">Armour</div>
        <div class="armour-row-header">Total</div>
        <div class="armour-row-header"></div>
        <div class="armour-row-header">Base</div>
        <div class="armour-row-header">AC</div>
        <div class="armour-row-header">Ability</div>
        <div class="armour-row-header">Nat</div>
        <div class="armour-row-header">Other</div>
    </div>
    <div class="armour-list">
        <div class="armour-row-header">Armour Class</div>
        <div class="armour-list-row-content">@_totalArmourClass</div>
        <div class="armour-row-header">=</div>
        <div class="armour-list-row-content">@_baseArmourClass</div>
        <div class="armour-list-row-content">@_equippedArmourClass</div>
        <div class="armour-list-row-content">@_abilityArmourClassBonus</div>
        <div class="armour-list-row-content">@_naturalArmourClassBonus</div>
        <div class="armour-list-row-content">@_otherArmourClassBonus</div>
    </div>
    <div class="armour-list">
        <div class="armour-row-header">Flat Footed</div>
        <div class="armour-list-row-content">@_flatFootedTotalArmourClass</div>
        <div class="armour-row-header">=</div>
        <div class="armour-list-row-content">@_baseArmourClass</div>
        <div class="armour-list-row-content">@_flatFootedBodyArmourClass</div>
        <div class="armour-list-row-content">@_flatFootedAbilityArmourClassBonus</div>
        <div class="armour-list-row-content">@_flatFootedNaturalArmourClassBonus</div>
        <div class="armour-list-row-content">@_flatFootedOtherArmourClassBonus</div>
    </div>
    <div class="armour-list">
        <div class="armour-row-header">Touch</div>
        <div class="armour-list-row-content">@_touchTotalArmourClass</div>
        <div class="armour-row-header">=</div>
        <div class="armour-list-row-content">@_baseArmourClass</div>
        <div class="armour-list-row-content">@_touchBodyArmourClass</div>
        <div class="armour-list-row-content">@_touchAbilityArmourClassBonus</div>
        <div class="armour-list-row-content">@_touchNaturalArmourClassBonus</div>
        <div class="armour-list-row-content">@_touchOtherArmourClassBonus</div>
    </div>
</div>
<div class="weapon-row">
    <div class="weapon-list-left">
        <div class="weapon-row-header">Weapon</div>
        <div class="weapon-row-header">Full Attack</div>
        <div class="weapon-row-header">Damage</div>
    </div>
    @for (int i = 0; i < _equippedWeapons.Count; i++)
    {
        var weapon = i < _equippedWeapons.Count ? _equippedWeapons[i] : new WeaponDisplay();
        <div class="weapon-list-left">
            <div class="weapon-list-row-content">@weapon.Name</div>
            <div class="weapon-list-row-content">@weapon.AttackBonus</div>
            <div class="weapon-list-row-content">@weapon.Damage</div>
        </div>
    }
</div>
</div>
<div class="dnd-cs-top__right">
    <div class="skills-row">
        <div class="skills-row-header">Skills</div>
        <div class="skills-row-header">Ranks</div>
        <div class="skills-row-header">Modifier</div>

        @for (var i = 0; i < MaxRows; i++)
        {
            var skill = i < Skills.Count ? Skills[i] : null;

            <div class="@RowHeaderClass(i)">
                @(skill?.Name ?? "")
            </div>

            <div class="@RowContentClass(i)">
                @(skill?.Ranks.ToString() ?? "")
            </div>

            <div class="@RowContentClass(i)">
                @(skill?.Modifier.ToString() ?? "")
            </div>
        }
    </div>

    <div class="weapon-row">
        <div class="weapon-list-right">
            <div class="weapon-row-header">Critical</div>
            <div class="weapon-row-header">Type</div>
            <div class="weapon-row-header">Range</div>
            <div class="weapon-row-header">Notes</div>
        </div>
        @for (var i = 0; i < _equippedWeapons.Count; i++)
        {
            var weapon = i < _equippedWeapons.Count ? _equippedWeapons[i] : new WeaponDisplay();
            <div class="weapon-list-right">
                <div class="weapon-list-row-content">@weapon.Critical</div>
                <div class="weapon-list-row-content">@weapon.Type</div>
                <div class="weapon-list-row-content">@weapon.Range</div>
                <div class="weapon-list-row-content">@weapon.Notes</div>
            </div>
        }
    </div>
</div>
</div>
<div class="dnd-cc-features">
    <div class="dnd-cc-features__left">
        <div></div>
        <div></div>
    </div>
    <div class="dnd-cc-features__right">
        <div></div>
        <div></div>
    </div>
</div>
<div class="dnd-cc-inventory">
    <div class="inventory-row">
        <div class="inventory-row-header">Items</div>
        <div class="inventory-row-header">Qty</div>
        <div class="inventory-row-header">Wt (.lbs)</div>
        <div class="inventory-row-header">Description</div>

        @for (int i = 0; i < Inventory.Count; i++)
        {
            var item = i < Inventory.Count ? Inventory[i] : null;

            <div class="@InventoryRowLeftClass(i)">
                @((item?.Item.Name ?? "") + (item != null && !string.IsNullOrEmpty(item.EquippedSlot) ? " ●" : ""))
            </div>

            <div class="@InventoryRowCenterClass(i)">
                @(item?.Quantity.ToString() ?? "")
            </div>

            <div class="@InventoryRowCenterClass(i)">
                @((item?.Item.Weight * item?.Quantity).ToString() ?? "")
            </div>
            <div class="@InventoryRowLeftClass(i)">
                @(item?.Item.Description ?? "")
            </div>
        }
    </div>
</div>
</div>
</div>
</div>

@code {

    #region Fields

    [Parameter] public int Row { get; set; }
    private const int MaxRows = 52;

    private List<OrderData> _orders = [];
    private List<MoralityData> _moralities = [];
    private List<CharacterData> _characters = [];
    private List<CharacterSkillDisplay> Skills { get; set; } = [];
    private List<CharacterInventoryItem> Inventory { get; set; } = [];
    private List<CharacterInventoryItem> EquippedItems { get; set; } = [];

    private string _characterName = string.Empty;
    private string _characterClass = string.Empty;
    private string _characterRace = string.Empty;
    private string _characterExperience = string.Empty;
    private int? _characterHitPoints;
    private string _characterAlignment = string.Empty;
    private string _characterDeity = string.Empty;

    private int? _characterAge;
    private string _characterGender = string.Empty;
    private string _characterEyes = string.Empty;
    private string _characterHair = string.Empty;
    private string _characterSkin = string.Empty;
    private string _characterWeight = string.Empty;
    private string _characterHeight = string.Empty;
    private string _characterPlayerName = string.Empty;

    private readonly string[] _characterLanguages = new string[21];

    private int? _characterPlatinum;
    private int? _characterGold;
    private int? _characterSilver;
    private int? _characterCopper;

    private string _characterSpeed = string.Empty;
    private int _baseSpeed;
    private int _currentSpeed;
    private int _runSpeed;

    private double? _characterWeightCarried;
    private double? _characterLightLoad;
    private double? _characterMediumLoad;
    private double? _characterHeavyLoad;
    private double? _characterLiftOverHead;
    private double? _characterLiftOffGround;
    private double? _characterPushOrDrag;

    private string _characterArcaneSpellFailure = string.Empty;
    private string _characterBaseAttackBonus = string.Empty;

    private int? _characterStrength;
    private int? _characterStrengthMod;
    private int? _characterDexterity;
    private int? _characterDexterityMod;
    private int? _characterConstitution;
    private int? _characterConstitutionMod;
    private int? _characterIntelligence;
    private int? _characterIntelligenceMod;
    private int? _characterWisdom;
    private int? _characterWisdomMod;
    private int? _characterCharisma;
    private int? _characterCharismaMod;
    private int? _characterLuck;
    private int? _characterLuckMod;

    private double? _characterFortSave;
    private double? _characterRefSave;
    private double? _characterWillSave;

    private string? _wornArmour;
    private int? _bodyArmourClass;
    private string? _bodyCheckPenalty;
    private string? _bodyArmourType;
    private int? _bodyMaxDexBonus;

    private string? _wornShield;
    private int? _shieldArmourClass;
    private string? _shieldCheckPenalty;
    private string? _shieldArmourType;
    private int? _shieldMaxDexBonus;

    private int? _totalArmourClass;
    private int? _baseArmourClass;
    private int? _equippedArmourClass;
    private int? _abilityArmourClassBonus;
    private int? _naturalArmourClassBonus;
    private int? _otherArmourClassBonus;

    private int? _flatFootedTotalArmourClass;
    private int? _flatFootedBodyArmourClass;
    private int? _flatFootedAbilityArmourClassBonus;
    private int? _flatFootedNaturalArmourClassBonus;
    private int? _flatFootedOtherArmourClassBonus;

    private int? _touchTotalArmourClass;
    private int? _touchBodyArmourClass;
    private int? _touchAbilityArmourClassBonus;
    private int? _touchNaturalArmourClassBonus;
    private int? _touchOtherArmourClassBonus;

    private List<WeaponDisplay> _equippedWeapons = [];

    private class WeaponDisplay
    {
        public string Name { get; set; } = string.Empty;
        public string AttackBonus { get; set; } = string.Empty;
        public string Damage { get; set; } = string.Empty;
        public string Critical { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Range { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }

    #endregion

    #region Calculated Properties

    private string RowHeaderClass(int row)
        => row % 2 == 1
            ? "skills-list-row-header-alt"
            : "skills-list-row-header";

    private string RowContentClass(int row)
        => row % 2 == 1
            ? "skills-list-row-content-alt"
            : "skills-list-row-content";

    private string InventoryRowLeftClass(int row)
        => row % 2 == 1
            ? "inventory-list-row-left-alt"
            : "inventory-list-row-left";

    private string InventoryRowCenterClass(int row)
        => row % 2 == 1
            ? "inventory-list-row-center-alt"
            : "inventory-list-row-center";

    #endregion

    #region Lifecycle Methods

    protected override async Task OnInitializedAsync()
    {
        await using var db = CreateDbContext();
        _characters = await db.Characters
            .AsNoTracking()
            .ToListAsync();

        _orders = await db.Orders.AsNoTracking().ToListAsync();
        _moralities = await db.Moralities.AsNoTracking().ToListAsync();

        for (var i = 0; i < _characterLanguages.Length; i++)
        {
            _characterLanguages[i] = string.Empty;
        }

        await base.OnInitializedAsync();
    }

    private int SelectedCharacterId { get; set; }

    #endregion

    #region Load Character

    private async Task LoadCharacterAsync(int characterId)
    {
        if (characterId <= 0)
        {
            return;
        }

        try
        {
            await using var db = CreateDbContext();
            var character = await db.Characters
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.Id == characterId);

            if (character is null)
                return;

            var campaignTask = db.Campaigns
                .AsNoTracking()
                .Where(c => c.Id == character.CampaignId)
                .FirstOrDefaultAsync();

            var raceTask = db.Races
                .AsNoTracking()
                .FirstOrDefaultAsync(r => r.Id == character.Race);

            var deityTask = db.Deities
                .Where(d => d.Id == character.Deity)
                .Select(d => d.Name)
                .FirstOrDefaultAsync();

            var genderTask = db.Genders
                .Where(g => g.Id == character.Gender)
                .Select(g => g.Gender)
                .FirstOrDefaultAsync();

            var colorIds = new[] { character.Eyes, character.Hair, character.Skin };
            var colorsTask = db.Colours
                .AsNoTracking()
                .Where(c => colorIds.Contains(c.Id))
                .ToDictionaryAsync(c => c.Id, c => c.Colour);

            var languagesTask = db.Languages
                .AsNoTracking()
                .Where(l => character.Languages.Contains(l.Id))
                .Select(l => l.Name)
                .ToListAsync();

            var skillsTask = db.Skills
                .AsNoTracking()
                .OrderBy(s => s.Name)
                .ToListAsync();

            var inventoryTask = db.CharacterInventoryItems
                .AsNoTracking()
                .Include(i => i.Item)
                .Where(c => c.CharacterId == characterId)
                .OrderBy(i => i.Item.Name)
                .ToListAsync();

            var equippedItemsTask = db.CharacterInventoryItems
                .AsNoTracking()
                .Include(i => i.Item)
                .ThenInclude(item => item.Properties)
                .ThenInclude(p => p.PropertyDefinition)
                .Where(i => i.CharacterId == characterId && i.Location == "Equipped")
                .ToListAsync();

            var levelsTask = db.CharacterLevels
                .AsNoTracking()
                .Include(cl => cl.Class)
                .Include(cl => cl.SkillRanks)
                .ThenInclude(sr => sr.Skill)
                .Where(cl => cl.CharacterId == characterId)
                .OrderBy(cl => cl.Level)
                .ToListAsync();

            await Task.WhenAll(campaignTask, raceTask, deityTask, genderTask, colorsTask, languagesTask, skillsTask, inventoryTask, equippedItemsTask, levelsTask);

            var campaign = await campaignTask;
            var hideTrainedOnly = campaign?.HideTrainedOnlySkills ?? false;

            var race = await raceTask;
            var levels = await levelsTask;

            var primaryClass = levels.FirstOrDefault()?.Class;
            _characterClass = primaryClass?.Name ?? string.Empty;

            _characterDeity = await deityTask ?? string.Empty;
            _characterGender = await genderTask ?? string.Empty;

            var colors = await colorsTask;
            _characterEyes = colors.GetValueOrDefault(character.Eyes) ?? string.Empty;
            _characterHair = colors.GetValueOrDefault(character.Hair) ?? string.Empty;
            _characterSkin = colors.GetValueOrDefault(character.Skin) ?? string.Empty;

            var characterLanguageNames = await languagesTask;
            for (var i = 0; i < 21; i++)
            {
                _characterLanguages[i] = i < characterLanguageNames.Count
                    ? characterLanguageNames[i]
                    : string.Empty;
            }

            _characterStrength = character.Strength + race!.StrengthBonus;
            _characterStrengthMod = ConversionHelper.ConvertStatToBonus(_characterStrength.Value);
            _characterDexterity = character.Dexterity + race.DexterityBonus;
            _characterDexterityMod = ConversionHelper.ConvertStatToBonus(_characterDexterity.Value);
            _characterConstitution = character.Constitution + race.ConstitutionBonus;
            _characterConstitutionMod = ConversionHelper.ConvertStatToBonus(_characterConstitution.Value);
            _characterIntelligence = character.Intelligence + race.IntelligenceBonus;
            _characterIntelligenceMod = ConversionHelper.ConvertStatToBonus(_characterIntelligence.Value);
            _characterWisdom = character.Wisdom + race.WisdomBonus;
            _characterWisdomMod = ConversionHelper.ConvertStatToBonus(_characterWisdom.Value);
            _characterCharisma = character.Charisma + race.CharismaBonus;
            _characterCharismaMod = ConversionHelper.ConvertStatToBonus(_characterCharisma.Value);

            CalculateLuck();

            var totalHpRolled = levels.Sum(l => l.HitPointsRolled);
            var hpFromConstitution = _characterConstitutionMod * levels.Count;
            _characterHitPoints = totalHpRolled + hpFromConstitution;

            if (primaryClass != null)
            {
                _characterFortSave = SaveHelper.GetBaseSave(primaryClass.FortitudeSavePerLevel, _characterConstitution.Value) + race.FortitudeBonus;
                _characterRefSave = SaveHelper.GetBaseSave(primaryClass.ReflexSavePerLevel, _characterDexterity.Value) + race.ReflexBonus;
                _characterWillSave = SaveHelper.GetBaseSave(primaryClass.WillSavePerLevel, _characterWisdom.Value) + race.WillBonus;
            }

            Inventory = await inventoryTask;
            EquippedItems = await equippedItemsTask;

            _characterWeightCarried = GetCarriedWeight();

            var carryingCapacity = await db.CarryingCapacity
                .AsNoTracking()
                .SingleOrDefaultAsync(x => x.Id == _characterStrength);

            if (carryingCapacity != null)
            {
                _characterLightLoad = WeightHelper.GetWeight(carryingCapacity.LightLoad, race.Size);
                _characterMediumLoad = WeightHelper.GetWeight(carryingCapacity.MediumLoad, race.Size);
                _characterHeavyLoad = WeightHelper.GetWeight(carryingCapacity.HeavyLoad, race.Size);
                _characterLiftOverHead = WeightHelper.GetWeight(carryingCapacity.LiftOverHead, race.Size);
                _characterLiftOffGround = WeightHelper.GetWeight(carryingCapacity.LiftOffGround, race.Size);
                _characterPushOrDrag = WeightHelper.GetWeight(carryingCapacity.PushOrDrag, race.Size);
            }

            await CalculateEquippedArmour();
            await CalculateEquippedWeapons(race.Size);
            CalculateMovementSpeed(race);
            await GetTotalArmour(race.Size);

            var totalSkillRanks = levels
                .SelectMany(l => l.SkillRanks)
                .GroupBy(sr => sr.SkillId)
                .ToDictionary(
                    g => g.Key,
                    g => g.Sum(sr => sr.IsClassSkill ? sr.RanksPurchased : sr.RanksPurchased * 0.5)
                );

            var allSkills = await skillsTask;
            Skills = allSkills
                .Select(skill =>
                {
                    var totalRanks = totalSkillRanks.GetValueOrDefault(skill.Id, 0.0);

                    var attributeModifier = GetAttributeModifier(skill.Attribute);
                    var racialBonus = race.SkillBonuses.GetValueOrDefault(skill.Name, 0);
                    var totalAcp = GetTotalAcp();
                    var modifier = attributeModifier + (int)Math.Floor(totalRanks) + racialBonus + (skill.ArmourCheckPenaltyMultiplier * totalAcp);

                    return new CharacterSkillDisplay
                    {
                        Name = skill.Name,
                        Ranks = (int)Math.Floor(totalRanks),
                        Modifier = modifier,
                        IsTrainedOnly = skill.IsTrainedOnly
                    };
                })
                .Where(skill =>
                {
                    if (hideTrainedOnly && skill is { IsTrainedOnly: true, Ranks: 0 })
                    {
                        return false;
                    }

                    return true;
                })
                .ToList();

            _characterName = character.Name;
            _characterRace = race.Race;
            _characterExperience = $"{character.Experience}/{500 * (levels.Count + 1) * levels.Count}";
            _characterAlignment = AlignmentHelper.GetAlignmentFromOrderAndMorality(_orders, _moralities, character.Order, character.Morality);
            _characterAge = character.Age;
            _characterWeight = $"{character.Weight} lbs.";
            _characterHeight = ConversionHelper.ConvertInchesToFeetAndInches(character.Height);
            _characterPlayerName = character.PlayerName ?? string.Empty;

            _characterPlatinum = character.PlatinumPieces;
            _characterGold = character.GoldPieces;
            _characterSilver = character.SilverPieces;
            _characterCopper = character.CopperPieces;

            var totalBab = AttackBonusHelper.GetTotalBaseAttackBonus(levels);
            _characterBaseAttackBonus = AttackBonusHelper.GetAttackBonusDisplay(totalBab);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await NotificationService.AddNotification(NotificationType.Error, $"Failed to load character {characterId}: {ex.Message}");
        }
    }

    #endregion

    #region Calculations

    private void CalculateLuck()
    {
        if (_characterStrength.HasValue &&
            _characterDexterity.HasValue &&
            _characterConstitution.HasValue &&
            _characterIntelligence.HasValue &&
            _characterWisdom.HasValue &&
            _characterCharisma.HasValue)
        {
            _characterLuck = (_characterStrength +
                              _characterDexterity +
                              _characterConstitution +
                              _characterIntelligence +
                              _characterWisdom +
                              _characterCharisma) / 6;

            _characterLuckMod = ConversionHelper.ConvertStatToBonus(_characterLuck.Value);
        }
    }

    private int GetAttributeModifier(string? attribute)
    {
        return attribute switch
        {
            "Strength" => _characterStrengthMod ?? 0,
            "Dexterity" => _characterDexterityMod ?? 0,
            "Constitution" => _characterConstitutionMod ?? 0,
            "Intelligence" => _characterIntelligenceMod ?? 0,
            "Wisdom" => _characterWisdomMod ?? 0,
            "Charisma" => _characterCharismaMod ?? 0,
            _ => 0
        };
    }

    private double? GetCarriedWeight()
    {
        double? sum = 0;
        foreach (var item in Inventory)
        {
            var totalItemWeight = item.Item.Weight * item.Quantity;
            sum += totalItemWeight;
        }

        return sum;
    }

    private EncumbranceLevel GetEncumbranceLevel()
    {
        var carried = _characterWeightCarried ?? 0;

        if (carried <= _characterLightLoad)
            return EncumbranceLevel.Light;

        if (carried <= _characterMediumLoad)
            return EncumbranceLevel.Medium;

        if (carried <= _characterHeavyLoad)
            return EncumbranceLevel.Heavy;

        return EncumbranceLevel.Overloaded;
    }

    private int GetEncumbranceAcp()
    {
        return GetEncumbranceLevel() switch
        {
            EncumbranceLevel.Light => 0,
            EncumbranceLevel.Medium => -3,
            EncumbranceLevel.Heavy => -6,
            _ => 0
        };
    }

    private int GetTotalAcp()
    {
        return GetEncumbranceAcp() + GetTotalArmorCheckPenalty();
    }

    private int GetEncumbranceMaxDex()
    {
        return GetEncumbranceLevel() switch
        {
            EncumbranceLevel.Light => 99,
            EncumbranceLevel.Medium => 3,
            EncumbranceLevel.Heavy => 1,
            _ => 0
        };
    }

    private async Task CalculateEquippedArmour()
    {
        try
        {
            var bodyArmour = EquippedItems.FirstOrDefault(i => i.EquippedSlot == "Body");
            if (bodyArmour != null)
            {
                _wornArmour = bodyArmour.Item.Name;
                _bodyArmourClass = GetPropertyIntValue(bodyArmour, PropertyApplication.ArmourClass);
                _bodyCheckPenalty = GetPropertyStringValue(bodyArmour, PropertyApplication.ArmourCheckPenalty);
                _bodyArmourType = ItemTypeHelper.GetArmourType(bodyArmour.Item.ItemSubtype!.Value);
                _bodyMaxDexBonus = GetPropertyIntValue(bodyArmour, PropertyApplication.MaxDexBonus);
            }
            else
            {
                _wornArmour = null;
                _bodyArmourClass = null;
                _bodyCheckPenalty = null;
                _bodyArmourType = null;
                _bodyMaxDexBonus = null;
            }

            var shield = EquippedItems.FirstOrDefault(i => i is { EquippedSlot: "OffHand", Item.ItemType: ItemType.Shield });
            if (shield != null)
            {
                _wornShield = shield.Item.Name;
                _shieldArmourClass = GetPropertyIntValue(shield, PropertyApplication.ArmourClass);
                _shieldCheckPenalty = GetPropertyStringValue(shield, PropertyApplication.ArmourCheckPenalty);
                _shieldArmourType = ItemTypeHelper.GetArmourType(shield.Item.ItemSubtype!.Value);
                _shieldMaxDexBonus = GetPropertyIntValue(shield, PropertyApplication.MaxDexBonus);
            }
            else
            {
                _wornShield = null;
                _shieldArmourClass = null;
                _shieldCheckPenalty = null;
                _shieldArmourType = null;
                _shieldMaxDexBonus = null;
            }

            if (EquippedItems.Count > 0)
            {
                var totalArcaneSpellFailure = 0;
                foreach (var item in EquippedItems)
                {
                    var spellFailure = GetPropertyIntValue(item, PropertyApplication.ArcaneSpellFailure);
                    if (spellFailure.HasValue)
                    {
                        totalArcaneSpellFailure += spellFailure.Value;
                    }
                }

                _characterArcaneSpellFailure = $"{totalArcaneSpellFailure}%";
            }
        }
        catch (Exception ex)
        {
            await NotificationService.AddNotification(NotificationType.Error, $"Failed to calculate armour: {ex.Message}");
        }
    }

    private async Task CalculateEquippedWeapons(string size)
    {
        try
        {
            _equippedWeapons.Clear();

            await using var db = CreateDbContext();
            var characterLevels = await db.CharacterLevels.Include(cl => cl.Class).Where(cl => cl.CharacterId == SelectedCharacterId).ToListAsync();
            var bab = AttackBonusHelper.GetTotalBaseAttackBonus(characterLevels);
            var sizeBonus = SizeHelper.GetRaceSizeModifier(size);

            var unarmed = new WeaponDisplay
            {
                Name = "Strike, Unarmed",
                AttackBonus = AttackBonusHelper.GetAttackBonusDisplay(bab + (_characterStrengthMod ?? 0) + sizeBonus),
                Critical = "20/x2",
                Type = "Bludgeoning",
                Range = "0 ft.",
                Notes = "Nonlethal"
            };

            var unarmedBaseDamage = size switch
            {
                "Small" => "1d2",
                "Medium" => "1d3",
                "Large" => "1d4",
                "Huge" => "1d6",
                "Gargantuan" => "1d8",
                "Colossal" => "2d6",
                _ => "1"
            };
            unarmed.Damage = (_characterStrengthMod ?? 0) != 0 
                ? $"{unarmedBaseDamage}{((_characterStrengthMod ?? 0) > 0 ? "+" : "")}{_characterStrengthMod}" 
                : unarmedBaseDamage;

            _equippedWeapons.Add(unarmed);

            var setSlots = new[] 
            { 
                "MainHand", "OffHand", 
                "MainHandSet2", "OffHandSet2", 
                "MainHandSet3", "OffHandSet3",
                "MainHandSet4", "OffHandSet4",
                "MainHandSet5", "OffHandSet5"
            };

            foreach (var slot in setSlots)
            {
                var weapon = EquippedItems.FirstOrDefault(i => i.EquippedSlot == slot && i.Item.ItemType == ItemType.Weapon);
                if (weapon == null) continue;

                var offHandSlot = slot.StartsWith("MainHand") 
                    ? (slot == "MainHand" ? "OffHand" : slot.Replace("MainHand", "OffHand"))
                    : null;

                var offHandItem = !string.IsNullOrEmpty(offHandSlot) 
                    ? EquippedItems.FirstOrDefault(i => i.EquippedSlot == offHandSlot)
                    : null;

                var offHandFree = offHandItem == null;
                var isDoubleWeapon = GetPropertyBoolValue(weapon, PropertyApplication.DoubleWeapon);
                var weaponType = GetPropertyStringValue(weapon, PropertyApplication.WeaponType);
                var weaponSubtype = weapon.Item.ItemSubtype.ToString();
                
                var isOneHanded = !string.IsNullOrEmpty(weaponType) && weaponType.Contains("One-Handed", StringComparison.OrdinalIgnoreCase);
                var isTwoHanded = !string.IsNullOrEmpty(weaponType) && weaponType.Contains("Two-Handed", StringComparison.OrdinalIgnoreCase);
                var isSimple = !string.IsNullOrEmpty(weaponSubtype) && weaponSubtype.Contains("Simple", StringComparison.OrdinalIgnoreCase);

                var versions = 1;
                var hasAutoTwoHanded = false;
                var hasAutoDoubleTwf = false;

                if (slot.StartsWith("MainHand") && offHandFree)
                {
                    if (isDoubleWeapon)
                    {
                        versions = 3;
                        hasAutoDoubleTwf = true;
                    }
                    else if (isOneHanded && !isSimple)
                    {
                        versions = 2;
                        hasAutoTwoHanded = true;
                    }
                }

                for (var v = 0; v < versions; v++)
                {
                    var display = new WeaponDisplay();

                    var attackBonusProp = weapon.Item.Properties
                        .Where(p => p.PropertyDefinition.AppliesTo == PropertyApplication.AttackBonus)
                        .Sum(p => int.TryParse(p.Value, out var val) ? val : 0);

                    var enhancement = weapon.Item.Properties
                        .Where(p => p.PropertyDefinition.AppliesTo == PropertyApplication.Enhancement)
                        .Sum(p => int.TryParse(p.Value, out var val) ? val : 0);

                    var subtype = weapon.Item.ItemSubtype.ToString();
                    var isRanged = subtype != null && subtype.Contains("Ranged");
                    var abilityMod = isRanged ? (_characterDexterityMod ?? 0) : (_characterStrengthMod ?? 0);

                    var effectiveTwoHanded = false;
                    var isOffHandUse = false;
                    var twfPenalty = 0;

                    if (hasAutoDoubleTwf)
                    {
                        if (v == 0) { effectiveTwoHanded = true; }
                        else if (v == 1) { twfPenalty = -2; }
                        else if (v == 2) { isOffHandUse = true; twfPenalty = -2; }
                    }
                    else if (hasAutoTwoHanded)
                    {
                        if (v == 1) effectiveTwoHanded = true;
                    }
                    else
                    {
                        effectiveTwoHanded = isTwoHanded;
                        isOffHandUse = slot.StartsWith("OffHand");
                    }

                    var totalAttackBonus = bab + abilityMod + enhancement + attackBonusProp + sizeBonus + twfPenalty;

                    if (isRanged && GetPropertyIntValue(weapon, PropertyApplication.Composite).HasValue)
                    {
                        var compositeRating = GetPropertyIntValue(weapon, PropertyApplication.Composite) ?? 0;
                        if ((_characterStrengthMod ?? 0) < compositeRating)
                        {
                            totalAttackBonus -= 2;
                        }
                    }

                    display.AttackBonus = AttackBonusHelper.GetAttackBonusDisplay(totalAttackBonus);

                    var damageDiceProps = weapon.Item.Properties
                        .Where(p => p.PropertyDefinition.AppliesTo == PropertyApplication.DamageDice)
                        .ToList();

                    var baseDamage = damageDiceProps.FirstOrDefault()?.Value ?? "0";
                    var extraDamage = string.Join(" + ", damageDiceProps.Skip(1).Select(p => p.Value));

                    var damageBonusProp = weapon.Item.Properties
                        .Where(p => p.PropertyDefinition.AppliesTo == PropertyApplication.DamageBonus)
                        .Sum(p => int.TryParse(p.Value, out var val) ? val : 0);

                    var damageAbilityMod = isRanged ? 0 : (_characterStrengthMod ?? 0);

                    if (isRanged && GetPropertyIntValue(weapon, PropertyApplication.Composite).HasValue)
                    {
                        var compositeRating = weapon.Item.Properties
                            .Where(p => p.PropertyDefinition.AppliesTo == PropertyApplication.Composite)
                            .Select(p => int.TryParse(p.Value, out var val) ? val : 99)
                            .FirstOrDefault();
                        damageAbilityMod = Math.Max(0, Math.Min(_characterStrengthMod ?? 0, compositeRating));
                    }

                    if (effectiveTwoHanded && !isRanged && damageAbilityMod > 0)
                    {
                        damageAbilityMod = (int)Math.Floor(damageAbilityMod * 1.5);
                    }
                    else if (isOffHandUse && damageAbilityMod > 0)
                    {
                        damageAbilityMod = (int)Math.Floor(damageAbilityMod * 0.5);
                    }

                    var totalDamageBonus = damageAbilityMod + enhancement + damageBonusProp;

                    display.Damage = baseDamage;
                    if (totalDamageBonus != 0)
                        display.Damage += (totalDamageBonus > 0 ? "+" : "") + totalDamageBonus;
                    if (!string.IsNullOrEmpty(extraDamage))
                        display.Damage += " + " + extraDamage;

                    display.Name = weapon.Item.Name;
                    if (hasAutoDoubleTwf)
                    {
                        display.Name += v switch { 0 => " (2H)", 1 => " (Primary)", 2 => " (Off-Hand)", _ => "" };
                    }
                    else if (hasAutoTwoHanded && v == 1)
                    {
                        display.Name += " (2H)";
                    }

                    var critRange = GetPropertyStringValue(weapon, PropertyApplication.CriticalRange) ?? "20";
                    var critMult = GetPropertyStringValue(weapon, PropertyApplication.CriticalMultiplier) ?? "x2";
                    display.Critical = $"{critRange}/{critMult}";

                    display.Type = GetPropertyStringValue(weapon, PropertyApplication.DamageType) ?? string.Empty;
                    display.Range = (GetPropertyStringValue(weapon, PropertyApplication.WeaponRange) ?? "0") + " ft.";

                    var tags = new List<string>();
                    if (GetPropertyBoolValue(weapon, PropertyApplication.Reach)) tags.Add("Reach");
                    if (GetPropertyBoolValue(weapon, PropertyApplication.Nonlethal)) tags.Add("Nonlethal");
                    if (GetPropertyBoolValue(weapon, PropertyApplication.Trip)) tags.Add("Trip");

                    display.Notes = string.Join(", ", tags);

                    _equippedWeapons.Add(display);
                }
            }
        }
        catch (Exception ex)
        {
            await NotificationService.AddNotification(NotificationType.Error, $"Failed to calculate weapons: {ex.Message}");
        }
    }

    private int? GetPropertyIntValue(CharacterInventoryItem item, PropertyApplication application)
    {
        var property = item.Item.Properties
            .FirstOrDefault(p => p.PropertyDefinition.AppliesTo == application);

        if (property != null && int.TryParse(property.Value, out int value))
        {
            return value;
        }

        return null;
    }

    private string? GetPropertyStringValue(CharacterInventoryItem item, PropertyApplication application)
    {
        var property = item.Item.Properties
            .FirstOrDefault(p => p.PropertyDefinition.AppliesTo == application);

        return property?.Value;
    }

    private bool GetPropertyBoolValue(CharacterInventoryItem item, PropertyApplication application)
    {
        return item.Item.Properties.Any(p => p.PropertyDefinition.AppliesTo == application);
    }

    private int GetTotalArmorCheckPenalty()
    {
        int penalty = 0;
    
        if (!string.IsNullOrEmpty(_bodyCheckPenalty) && int.TryParse(_bodyCheckPenalty, out int bodyPenalty))
            penalty += bodyPenalty;
    
        if (!string.IsNullOrEmpty(_shieldCheckPenalty) && int.TryParse(_shieldCheckPenalty, out int shieldPenalty))
            penalty += shieldPenalty;
    
        return penalty;
    }

    private Task GetTotalArmour(string size)
    {
        _baseArmourClass = 10 + SizeHelper.GetRaceSizeModifier(size);

        var armourMaxDex = _bodyMaxDexBonus ?? 99;
        var shieldMaxDex = _shieldMaxDexBonus ?? 99;
        var equipmentMaxDex = Math.Min(armourMaxDex, shieldMaxDex);

        var finalMaxDex = Math.Min(equipmentMaxDex, GetEncumbranceMaxDex());

        _equippedArmourClass = (_bodyArmourClass ?? 0) + (_shieldArmourClass ?? 0);
        _abilityArmourClassBonus = Math.Min(_characterDexterityMod ?? 0, finalMaxDex);
        _naturalArmourClassBonus = 0;
        _otherArmourClassBonus = 0;
        _totalArmourClass = _baseArmourClass + _bodyArmourClass + _shieldArmourClass + _abilityArmourClassBonus + _naturalArmourClassBonus + _otherArmourClassBonus;

        _flatFootedBodyArmourClass =  (_bodyArmourClass ?? 0) + (_shieldArmourClass ?? 0);
        _flatFootedAbilityArmourClassBonus = 0;
        _flatFootedNaturalArmourClassBonus = 0;
        _flatFootedOtherArmourClassBonus = 0;
        _flatFootedTotalArmourClass = _baseArmourClass + _flatFootedBodyArmourClass + _flatFootedAbilityArmourClassBonus + _flatFootedNaturalArmourClassBonus + _flatFootedOtherArmourClassBonus;

        _touchBodyArmourClass = 0;
        _touchAbilityArmourClassBonus = Math.Min(_characterDexterityMod ?? 0, finalMaxDex);
        _touchNaturalArmourClassBonus = 0;
        _touchOtherArmourClassBonus = 0;
        _touchTotalArmourClass = _baseArmourClass + _touchBodyArmourClass + _touchAbilityArmourClassBonus + _touchNaturalArmourClassBonus + _touchOtherArmourClassBonus;

        return Task.CompletedTask;
    }

    private void CalculateMovementSpeed(RaceData race)
    {
        _baseSpeed = race.BaseSpeed;
        _currentSpeed = _baseSpeed;

        var encumbranceReduction = GetEncumbranceSpeedReduction();
        if (encumbranceReduction > 0)
        {
            _currentSpeed -= encumbranceReduction;
        }

        var armorReduction = GetArmorSpeedReduction(race.Size, race.Race);
        if (armorReduction > 0)
        {
            if (armorReduction > encumbranceReduction)
            {
                _currentSpeed = _baseSpeed - armorReduction;
            }
        }

        var speedBonus = GetSpeedModifier();
        _currentSpeed += speedBonus;

        _currentSpeed = Math.Max(0, _currentSpeed);

        var heavyRestriction = _bodyArmourType == "Heavy" || (_characterWeightCarried > _characterMediumLoad);
        _runSpeed = heavyRestriction ? _currentSpeed * 3 : _currentSpeed * 4;

        _characterSpeed = $"{_currentSpeed} ft. ({_runSpeed} ft.)";
    }

    private int GetEncumbranceSpeedReduction()
    {
        if (_characterWeightCarried <= _characterLightLoad)
            return 0;

        return _baseSpeed switch
        {
            20 => 5,
            30 => 10,
            40 => 10,
            _ => (int)(_baseSpeed * 1.0 / 3.0)
        };
    }

    private int GetArmorSpeedReduction(string size, string race)
    {
        if (race.Contains("Dwarf", StringComparison.OrdinalIgnoreCase))
            return 0;

        if (size != "Small" && size != "Medium")
            return 0;

        var armorType = _bodyArmourType;

        if (armorType == "Medium" || armorType == "Heavy")
        {
            return _baseSpeed switch
            {
                30 => 10,
                20 => 5,
                40 => 10,
                _ => (int)(_baseSpeed * 1.0 / 3.0)
            };
        }

        return 0;
    }

    private int GetSpeedModifier()
    {
        var flatAdjustment = 0;
        var multiplier = 1.0;

        foreach (var item in EquippedItems)
        {
            foreach (var prop in item.Item.Properties)
            {
                switch (prop.PropertyDefinition.AppliesTo)
                {
                    case PropertyApplication.SpeedAdjustment:
                        if (int.TryParse(prop.Value, out int speedAdjustment))
                            flatAdjustment += speedAdjustment;
                        break;

                    case PropertyApplication.SpeedMultiplier:
                        if (double.TryParse(prop.Value, out double speedMultiplier))
                            multiplier *= speedMultiplier;
                        break;
                }
            }
        }

        var speedAfterMultiplier = (int)(_currentSpeed * multiplier);
        return speedAfterMultiplier - _currentSpeed + flatAdjustment;
    }

    #endregion

}